  "file": "03_Команда_remember.py",
  "statement": "Бот запоминает факты. Вопрос: «Ты: ».\n• «/remember ключ=значение» — сохранить в словарь profile и ответить «Запомнил: ключ — значение»;\n• «/profile» — напечатать все факты строками «ключ: значение»;\n• «/exit» — конец.",
  "dialog": [
    [
      "bot",
      "Ты:"
    ],
    [
      "you",
      "/remember еда=пицца"
    ],
    [
      "bot",
      "Запомнил: еда — пицца\nТы:"
    ],
    [
      "you",
      "/profile"
    ],
    [
      "bot",
      "еда: пицца"
    ]
  ],
  "tests": [
    {
      "input": [
        "/remember еда=пицца",
        "/profile",
        "/exit"
      ],
      "expect": [
        "Запомнил: еда — пицца",
        "еда: пицца"
      ]
    },
    {
      "input": [
        "/remember хобби=футбол",
        "/remember город=Омск",
        "/profile",
        "/exit"
      ],
      "expect": [
        "хобби: футбол",
        "город: Омск"
      ]
    },
    {
      "input": [
        "/profile",
        "/exit"
      ],
      "reject": [
        "Запомнил"
      ]
    }
  ],
  "structure": [
    {
      "need": "dict",
      "msg": "Факты храни в словаре profile = {}."
    },
    {
      "need": "method:split",
      "msg": "Раздели «ключ=значение» по знаку =: text.split(\"=\")."
    }
  ],
  "hints": [
    "text[10:] — всё после «/remember » (это 10 символов). Получится «еда=пицца».",
    "key, value = rest.split(\"=\", 1) — режет строку по первому знаку = на две части. Сохрани: profile[key] = value.",
    "for key, value in profile.items():\n    print(f\"{key}: {value}\")"
